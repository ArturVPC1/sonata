# Banco de dados (Neon PostgreSQL em produção; PostgreSQL local em desenvolvimento)
# Exemplo local:  postgresql://postgres:postgres@localhost:5432/sonata
# Exemplo Neon:   postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO"

# Auth.js — gere um valor novo com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-gerado"

# Opcional: mostra botões de login rápido (Funcionário/Professor/Aluno) na tela de login.
# Use "true" apenas em demonstração; deixe vazio em produção real.
NEXT_PUBLIC_DEMO_LOGINS="false"

# Data de referência do seed (padrão 2026-11-30, dia da apresentação)
# SEED_DATE="2026-11-30"
