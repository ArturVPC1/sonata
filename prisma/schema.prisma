generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SECRETARIA
  PROFESSOR
  ALUNO
}

enum SalaStatus {
  DISPONIVEL
  MANUTENCAO
}

enum TipoReserva {
  AULA
  ENSAIO_INDIVIDUAL
  ENSAIO_COLETIVO
}

enum StatusReserva {
  ATIVA
  CANCELADA
}

enum TipoSolicitacao {
  EXTRA
  REPOSICAO
}

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  REJEITADA
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  role      UserRole
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professor Professor?
  aluno     Aluno?

  reservas     Reserva[]
  notificacoes Notificacao[]
}

model Aluno {
  id        String    @id @default(cuid())
  nome      String
  email     String    @unique
  telefone  String?
  dataNasc  DateTime?
  cpf       String?   @unique
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Acesso do aluno ao sistema (opcional)
  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  // Responsável (obrigatório na regra de negócio para menores de 18 anos)
  responsavelNome     String?
  responsavelTelefone String?
  observacoes         String?

  matriculas   Matricula[]
  pagamentos   Pagamento[]
  solicitacoes SolicitacaoAula[]
}

model Professor {
  id        String   @id @default(cuid())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  telefone  String?
  bio       String?
  cpf                 String? @unique
  endereco            String?
  registroProfissional String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turmas       Turma[]
  reservas     Reserva[]
  solicitacoes SolicitacaoAula[]
}

model Instrumento {
  id    String  @id @default(cuid())
  nome  String  @unique
  icone String?

  turmas Turma[]
}

model Sala {
  id            String     @id @default(cuid())
  nome          String     @unique
  capacidade    Int        @default(4)
  status        SalaStatus @default(DISPONIVEL)
  manutencaoAte DateTime?
  recursos      String?

  turmas   Turma[]
  reservas Reserva[]
}

model Turma {
  id            String      @id @default(cuid())
  nome          String
  instrumentoId String
  instrumento   Instrumento @relation(fields: [instrumentoId], references: [id])
  professorId   String
  professor     Professor   @relation(fields: [professorId], references: [id])
  salaId        String?
  sala          Sala?       @relation(fields: [salaId], references: [id])
  diaSemana     DiaSemana
  horario       String
  duracaoMin    Int         @default(60)
  vagas         Int         @default(10)
  ativo         Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  matriculas Matricula[]
  aulas      Aula[]
}

model Matricula {
  id         String    @id @default(cuid())
  alunoId    String
  aluno      Aluno     @relation(fields: [alunoId], references: [id])
  turmaId    String
  turma      Turma     @relation(fields: [turmaId], references: [id])
  dataInicio DateTime
  dataFim    DateTime?
  ativo      Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@unique([alunoId, turmaId])
}

model Aula {
  id         String   @id @default(cuid())
  turmaId    String
  turma      Turma    @relation(fields: [turmaId], references: [id])
  data       DateTime
  realizada  Boolean  @default(false)
  observacao String?
  createdAt  DateTime @default(now())

  solicitacoes SolicitacaoAula[]

  @@unique([turmaId, data])
}

model Pagamento {
  id         String    @id @default(cuid())
  alunoId    String
  aluno      Aluno     @relation(fields: [alunoId], references: [id])
  valor      Decimal   @db.Decimal(10, 2)
  vencimento DateTime
  pago       Boolean   @default(false)
  dataPagto  DateTime?
  mes        Int
  ano        Int
  observacao String?
  createdAt  DateTime  @default(now())

  @@unique([alunoId, mes, ano])
}

model Reserva {
  id          String        @id @default(cuid())
  salaId      String
  sala        Sala          @relation(fields: [salaId], references: [id])
  criadoPorId String
  criadoPor   Usuario       @relation(fields: [criadoPorId], references: [id])
  professorId String?
  professor   Professor?    @relation(fields: [professorId], references: [id])
  tipo        TipoReserva
  observacao  String?
  data        DateTime
  duracaoMin  Int           @default(60)
  status      StatusReserva @default(ATIVA)
  createdAt   DateTime      @default(now())

  solicitacao SolicitacaoAula?
}

model SolicitacaoAula {
  id            String            @id @default(cuid())
  alunoId       String
  aluno         Aluno             @relation(fields: [alunoId], references: [id])
  professorId   String
  professor     Professor         @relation(fields: [professorId], references: [id])
  tipo          TipoSolicitacao
  data          DateTime
  duracaoMin    Int               @default(60)
  motivo        String
  aulaPerdidaId String?
  aulaPerdida   Aula?             @relation(fields: [aulaPerdidaId], references: [id])
  status        StatusSolicitacao @default(PENDENTE)
  decididoPorId String?
  decididoEm    DateTime?
  justificativa String?
  reservaId     String?           @unique
  reserva       Reserva?          @relation(fields: [reservaId], references: [id])
  createdAt     DateTime          @default(now())
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())
}
